# demo: deterministic rule table, no API key needed.
# groq: real LLM agents. Free key at https://console.groq.com/keys
LLM_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local development uses SQLite. docker compose overrides this with Postgres.
DATABASE_URL=sqlite:///./healthtech.db

# Signs the audit chain. Required (and must be changed) when ENVIRONMENT=production.
AUDIT_SIGNING_KEY=dev-only-audit-signing-key-change-me
ENVIRONMENT=development
LOG_LEVEL=INFO
